# Chirag configuration (copy to .env and adjust as needed)

# Backend selection: "ollama" (fully local) or "openai"
CHIRAG_LLM_BACKEND=ollama
CHIRAG_EMBEDDING_BACKEND=ollama

# --- Ollama (local) ---
CHIRAG_OLLAMA_BASE_URL=http://localhost:11434
CHIRAG_LLM_MODEL=qwen3.5:9b
CHIRAG_EMBEDDING_MODEL=nomic-embed-text

# --- OpenAI-compatible cloud backend (optional) ---
CHIRAG_OPENAI_API_KEY=
CHIRAG_OPENAI_BASE_URL=https://api.openai.com/v1
CHIRAG_OPENAI_LLM_MODEL=gpt-4o-mini
CHIRAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Text processing ---
CHIRAG_CHUNK_SIZE=1000
CHIRAG_CHUNK_OVERLAP=150

# --- Retrieval ---
CHIRAG_DEFAULT_TOP_K=5
CHIRAG_SIMILARITY_THRESHOLD=0.25

# --- Query handling ---
# Auto-translate non-English questions (e.g. Turkish) to English before
# retrieval; the answer is still generated in the user's language.
CHIRAG_TRANSLATE_QUERIES=true

# --- Vector store ---
CHIRAG_DB_PATH=data/chroma_db
CHIRAG_COLLECTION_NAME=chirag

# --- Generation ---
CHIRAG_TEMPERATURE=0.2
CHIRAG_MAX_GEN_TOKENS=8192

# --- Corpus ---
CHIRAG_PAPERS_DIR=kripto_makaleler
