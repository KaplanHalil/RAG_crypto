# CryptoRAG configuration (copy to .env and adjust as needed)

# Backend selection: "ollama" (fully local) or "openai"
CRAG_LLM_BACKEND=ollama
CRAG_EMBEDDING_BACKEND=ollama

# --- Ollama (local) ---
CRAG_OLLAMA_BASE_URL=http://localhost:11434
CRAG_LLM_MODEL=qwen3.5:9b
CRAG_EMBEDDING_MODEL=nomic-embed-text

# --- OpenAI-compatible cloud backend (optional) ---
CRAG_OPENAI_API_KEY=
CRAG_OPENAI_BASE_URL=https://api.openai.com/v1
CRAG_OPENAI_LLM_MODEL=gpt-4o-mini
CRAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Text processing ---
CRAG_CHUNK_SIZE=1000
CRAG_CHUNK_OVERLAP=150

# --- Retrieval ---
CRAG_DEFAULT_TOP_K=5
CRAG_SIMILARITY_THRESHOLD=0.25

# --- Vector store ---
CRAG_DB_PATH=data/chroma_db
CRAG_COLLECTION_NAME=crypto_rag

# --- Generation ---
CRAG_TEMPERATURE=0.2
CRAG_MAX_GEN_TOKENS=2048

# --- Corpus ---
CRAG_PAPERS_DIR=kripto_makaleler
